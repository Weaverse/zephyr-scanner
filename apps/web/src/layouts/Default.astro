---
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
  ogUrl?: string;
  canonical?: string;
}

const {
  title = "Agent Ready — Is your store agent-ready?",
  description = "Free commerce-focused agent readiness scanner. Score your Shopify, Hydrogen, or commerce store against 15 checks for AI-agent readiness.",
  ogImage,
  ogUrl,
  canonical,
} = Astro.props;

const path = Astro.url.pathname.replace(/\/$/, "") || "/";
const navItems = [
  { href: "/hydrogen", label: "Hydrogen" },
  { href: "/compare", label: "Compare" },
  { href: "/leaderboard", label: "Leaderboard" },
  { href: "/about", label: "About" },
];
const isActive = (href: string) => path === href || path.startsWith(`${href}/`);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    {ogUrl && <meta property="og:url" content={ogUrl} />}
    {ogImage && <meta property="og:image" content={ogImage} />}
    {ogImage && <meta property="og:image:width" content="1200" />}
    {ogImage && <meta property="og:image:height" content="630" />}
    <meta name="twitter:card" content={ogImage ? "summary_large_image" : "summary"} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    {ogImage && <meta name="twitter:image" content={ogImage} />}
    {canonical && <link rel="canonical" href={canonical} />}
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  </head>
  <body class="bg-zephyr-50 text-zephyr-900 min-h-screen flex flex-col">
    <header class="bg-gradient-to-r from-brand-700 to-brand-600 text-white shadow-sm">
      <div class="max-w-6xl mx-auto px-6 py-4 flex items-center justify-between">
        <a href="/" class="flex items-center gap-2.5">
          <img
            src="/logo.svg"
            alt="Agent Ready logo"
            width="32"
            height="32"
            class="h-8 w-8 shrink-0 drop-shadow-sm"
          />
          <span class="font-mono text-xl font-bold text-white">Agent Ready</span>
        </a>
        <nav class="flex gap-6 text-sm font-medium">
          {
            navItems.map((item) => (
              <a
                href={item.href}
                aria-current={isActive(item.href) ? "page" : undefined}
                class:list={[
                  "relative transition-colors",
                  isActive(item.href)
                    ? "font-semibold text-white after:absolute after:-bottom-1.5 after:left-0 after:right-0 after:h-0.5 after:rounded-full after:bg-white"
                    : "text-white/80 hover:text-white",
                ]}
              >
                {item.label}
              </a>
            ))
          }
          <a
            href="https://github.com/Weaverse/zephyr-scanner"
            class="text-white/80 transition-colors hover:text-white"
          >
            GitHub
          </a>
          <a
            href="https://weaverse.io"
            class="text-white/80 transition-colors hover:text-white"
          >
            Powered by Weaverse
          </a>
        </nav>
      </div>
    </header>
    <main class="flex-1">
      <slot />
    </main>
    <footer class="border-t border-zephyr-100 bg-white">
      <div
        class="max-w-6xl mx-auto px-6 py-6 text-sm text-zephyr-700 flex justify-between"
      >
        <span>MIT licensed · Built by Weaverse</span>
        <a
          href="https://github.com/Weaverse/zephyr-scanner"
          class="hover:text-brand-600"
        >
          github.com/Weaverse/zephyr-scanner
        </a>
      </div>
    </footer>
  </body>
</html>
