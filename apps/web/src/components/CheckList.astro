---
import {
  CATEGORY_LABELS,
  CATEGORY_ORDER,
  type CategoryScore,
  type CheckResult,
} from "../lib/api";

interface Props {
  results: CheckResult[];
  categories?: CategoryScore[];
}

const { results, categories = [] } = Astro.props;
const grouped = new Map<string, CheckResult[]>();
for (const r of results) {
  const list = grouped.get(r.category) ?? [];
  list.push(r);
  grouped.set(r.category, list);
}

const scoreByCategory = new Map(categories.map((c) => [c.category, c]));

// Tinted pill background for a 0–100 score.
function scoreBadgeClass(score: number): string {
  if (score >= 75) return "bg-grade-a/10 text-grade-a";
  if (score >= 60) return "bg-grade-c/10 text-grade-c";
  if (score >= 40) return "bg-grade-d/10 text-grade-d";
  return "bg-grade-f/10 text-grade-f";
}

// Text color for a per-check 0–100 score.
function scoreTextClass(score: number): string {
  if (score >= 75) return "text-grade-a";
  if (score >= 60) return "text-grade-c";
  if (score >= 40) return "text-grade-d";
  return "text-grade-f";
}

// Render category sections in the same canonical order as the breakdown bars.
const orderedGroups = [...grouped.entries()].sort(
  (a, b) =>
    CATEGORY_ORDER.indexOf(a[0] as CheckResult["category"]) -
    CATEGORY_ORDER.indexOf(b[0] as CheckResult["category"]),
);

function severityLabel(s: CheckResult["severity"]): string {
  switch (s) {
    case "critical":
      return "Critical";
    case "important":
      return "Important";
    case "nice-to-have":
      return "Nice-to-have";
  }
}

function statusClass(r: CheckResult): string {
  if (r.passed) return "bg-grade-a/10 text-grade-a";
  if (r.score >= 40) return "bg-grade-c/10 text-grade-c";
  return "bg-grade-f/10 text-grade-f";
}
---

<div class="space-y-6">
  {
    orderedGroups.map(([category, items]) => {
      const summary = scoreByCategory.get(category as CheckResult["category"]);
      return (
      <details class="group/cat overflow-hidden rounded-xl border border-zephyr-100 bg-white shadow-sm">
        <summary class="flex cursor-pointer list-none select-none items-center justify-between gap-3 bg-zephyr-50/60 px-5 py-4 transition-colors hover:bg-zephyr-50 [&::-webkit-details-marker]:hidden">
          <div class="flex items-center gap-3">
            <h3 class="text-lg font-bold tracking-tight text-zephyr-900">
              {CATEGORY_LABELS[category as keyof typeof CATEGORY_LABELS]}
            </h3>
            {summary && (
              <span
                class={`inline-flex items-center justify-center rounded-md px-2 py-0.5 text-sm font-bold ${scoreBadgeClass(summary.score)}`}
              >
                {summary.score}
              </span>
            )}
          </div>
          <div class="flex items-center gap-2.5 whitespace-nowrap">
            {summary && (
              <span class="hidden text-sm font-medium text-zephyr-700 sm:inline">
                {summary.passed}/{summary.total} passed
              </span>
            )}
            <svg
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              class="h-5 w-5 text-zephyr-400 transition-transform duration-200 group-open/cat:rotate-180"
            >
              <path d="m6 9 6 6 6-6" />
            </svg>
          </div>
        </summary>
        <ul class="divide-y divide-zephyr-100 border-t border-zephyr-100">
          {items.map((r) => (
            <li>
              <details class="group/check">
                <summary class="flex items-center justify-between gap-3 px-5 py-3.5 cursor-pointer list-none select-none transition-colors hover:bg-zephyr-50/60 [&::-webkit-details-marker]:hidden">
                  <span class="flex items-center gap-3">
                    <span
                      class={`inline-flex items-center text-xs font-bold uppercase tracking-wide rounded-full px-2.5 py-1 ${statusClass(r)}`}
                    >
                      {r.passed ? "Pass" : "Fix"}
                    </span>
                    <span class="font-semibold text-zephyr-900">{r.name}</span>
                    <span class="hidden sm:inline text-xs font-medium text-zephyr-500">
                      {severityLabel(r.severity)}
                    </span>
                  </span>
                  <span class="flex items-center gap-3">
                    <span class={`text-sm font-mono font-bold ${scoreTextClass(r.score)}`}>
                      {r.score}<span class="text-zephyr-400 font-normal">/100</span>
                    </span>
                    <svg
                      viewBox="0 0 24 24"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="2"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      class="h-4 w-4 text-zephyr-400 transition-transform duration-200 group-open/check:rotate-180"
                    >
                      <path d="m6 9 6 6 6-6" />
                    </svg>
                  </span>
                </summary>
                <div class="px-5 pb-4 text-sm text-zephyr-900 space-y-3">
                  <p>{r.detail}</p>
                  {r.fixHint && (
                    <p class="border-l-4 border-grade-c pl-3 text-zephyr-700">
                      <strong class="text-zephyr-900">How to fix:</strong> {r.fixHint}
                    </p>
                  )}
                  {r.evidence && (
                    <details>
                      <summary class="cursor-pointer text-zephyr-700 text-xs">
                        Raw evidence
                      </summary>
                      <pre class="mt-2 p-3 rounded bg-zephyr-50 text-xs overflow-x-auto font-mono">
{JSON.stringify(r.evidence, null, 2)}
                      </pre>
                    </details>
                  )}
                </div>
              </details>
            </li>
          ))}
        </ul>
      </details>
      );
    })
  }
</div>
