---
import { CATEGORY_LABELS, CATEGORY_ORDER, type CategoryScore } from "../lib/api";

interface Props {
  categories: CategoryScore[];
}

const { categories } = Astro.props;

function barColor(score: number): string {
  if (score >= 75) return "bg-grade-a";
  if (score >= 60) return "bg-grade-c";
  if (score >= 40) return "bg-grade-d";
  return "bg-grade-f";
}

function scoreText(score: number): string {
  if (score >= 75) return "text-grade-a";
  if (score >= 60) return "text-grade-c";
  if (score >= 40) return "text-grade-d";
  return "text-grade-f";
}

const sorted = [...categories].sort(
  (a, b) =>
    CATEGORY_ORDER.indexOf(a.category) - CATEGORY_ORDER.indexOf(b.category),
);
---

<div class="space-y-4">
  {
    sorted.map((c) => (
      <div>
        <div class="mb-1.5 flex items-baseline justify-between gap-3">
          <span class="text-sm font-medium text-zephyr-900">
            {CATEGORY_LABELS[c.category]}
          </span>
          <span class="flex items-baseline gap-1.5">
            <span class={`text-sm font-bold ${scoreText(c.score)}`}>
              {c.score}
            </span>
            <span class="text-xs text-zephyr-500">
              · {c.passed}/{c.total}
            </span>
          </span>
        </div>
        <div class="h-2 w-full overflow-hidden rounded-full bg-zephyr-100">
          <div
            class={`cat-bar h-full rounded-full ${barColor(c.score)}`}
            style={`width: ${c.score}%`}
          />
        </div>
      </div>
    ))
  }
</div>

<style>
  .cat-bar {
    transform-origin: left;
    animation: cat-grow 0.9s cubic-bezier(0.22, 1, 0.36, 1) forwards;
  }
  @keyframes cat-grow {
    from {
      transform: scaleX(0);
    }
    to {
      transform: scaleX(1);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .cat-bar {
      animation: none;
    }
  }
</style>
