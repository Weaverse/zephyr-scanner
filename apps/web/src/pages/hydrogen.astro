---
import Default from "../layouts/Default.astro";
import Eyebrow from "../components/Eyebrow.astro";

const title = "Is your Hydrogen store agent-ready? — Agent Ready";
const description =
  "The agent-readiness checklist for Shopify Hydrogen and headless storefronts. Why generic scanners miss headless, and the 15 checks that actually matter for AI commerce.";
const canonical = "https://isyourstoreagentready.com/hydrogen";

const icons = {
  search: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" class="w-5 h-5"><path d="m21 21-5.2-5.2m0 0A7.5 7.5 0 1 0 5.2 5.2a7.5 7.5 0 0 0 10.6 10.6Z"/></svg>`,
  doc: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" class="w-5 h-5"><path d="M9 12h6m-6 4h6m2 5H7a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h5.6a1 1 0 0 1 .7.3l5.4 5.4a1 1 0 0 1 .3.7V19a2 2 0 0 1-2 2Z"/></svg>`,
  bag: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" class="w-5 h-5"><path d="M15.75 10.5V6a3.75 3.75 0 1 0-7.5 0v4.5M4.4 8.5h15.2l1.1 11.2a1.1 1.1 0 0 1-1.1 1.3H4.4a1.1 1.1 0 0 1-1.1-1.3L4.4 8.5Z"/></svg>`,
  cube: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" class="w-5 h-5"><path d="m21 7.5-9-5.25L3 7.5m18 0-9 5.25m9-5.25v9l-9 5.25M3 7.5l9 5.25M3 7.5v9l9 5.25m0-9v9"/></svg>`,
  card: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" class="w-5 h-5"><path d="M2.5 9h19M6 14.5h4.5M4.5 18.75h15A2.25 2.25 0 0 0 21.75 16.5v-9A2.25 2.25 0 0 0 19.5 5.25h-15A2.25 2.25 0 0 0 2.25 7.5v9A2.25 2.25 0 0 0 4.5 18.75Z"/></svg>`,
};

const checklist = [
  {
    cat: "Discoverability",
    icon: icons.search,
    accent: "bg-sky-50 text-sky-600 ring-sky-100",
    items: [
      "robots.txt is served by your Hydrogen app, not Shopify's online store — headless splits these, and most stores ship the framework default.",
      "sitemap.xml routes resolve on your custom domain, not the myshopify.com origin.",
      "AI bot user-agents (GPTBot, ClaudeBot, PerplexityBot, Google-Extended) have explicit rules.",
    ],
  },
  {
    cat: "Content",
    icon: icons.doc,
    accent: "bg-violet-50 text-violet-600 ring-violet-100",
    items: [
      "llms.txt manifest at the domain root — the single highest-leverage file, and almost never present on a headless build.",
      "Markdown content negotiation (Accept: text/markdown) for product and policy pages.",
    ],
  },
  {
    cat: "Commerce protocols",
    icon: icons.bag,
    accent: "bg-brand-50 text-brand-600 ring-brand-100",
    items: [
      "UCP profile exposed at /.well-known/ucp — Shopify ships this on Liquid storefronts, but headless apps must wire it through themselves.",
      "MCP server card discovery (SEP-2127).",
      "ACP / x402 / WebMCP opt-in markers where applicable.",
    ],
  },
  {
    cat: "Product data",
    icon: icons.cube,
    accent: "bg-emerald-50 text-emerald-600 ring-emerald-100",
    items: [
      "Product JSON-LD rendered server-side — client-only React hydration means agents that don't run JS see nothing.",
      "ProductGroup + variant/pricing clarity for variant families.",
      "Open Graph / Twitter cards on PDPs.",
    ],
  },
  {
    cat: "Checkout",
    icon: icons.card,
    accent: "bg-amber-50 text-amber-600 ring-amber-100",
    items: [
      "Cart permalinks resolve.",
      "Checkout handoff URL is reachable and not gated behind JS.",
    ],
  },
];
---

<Default
  title={title}
  description={description}
  ogUrl={canonical}
  canonical={canonical}
>
  <section class="relative overflow-hidden border-b border-zephyr-100 bg-gradient-to-b from-brand-50/70 via-white to-white">
    <div class="hero-grid pointer-events-none absolute inset-0" aria-hidden="true"></div>
    <div class="pointer-events-none absolute -left-24 -top-24 h-72 w-72 rounded-full bg-brand-500/20 blur-3xl" aria-hidden="true"></div>
    <div class="pointer-events-none absolute -right-20 top-0 h-72 w-72 rounded-full bg-sky-400/20 blur-3xl" aria-hidden="true"></div>
    <div class="relative max-w-3xl mx-auto px-6 py-20 text-center">
      <Eyebrow label="For Hydrogen & headless stores" />
      <h1 class="mt-6 text-4xl sm:text-5xl font-bold tracking-tight text-zephyr-900 mb-4">
        Is your Hydrogen store
        <span class="bg-gradient-to-r from-brand-600 to-sky-500 bg-clip-text text-transparent">
          agent-ready?
        </span>
      </h1>
      <p class="text-lg text-zephyr-700 mb-8">
        Generic readiness scanners assume a classic Liquid storefront. Headless
        Hydrogen builds split robots, sitemaps, structured data, and protocol
        endpoints across your own app — so the things Shopify serves for free are
        suddenly yours to wire up. Agent Ready checks the headless reality.
      </p>
      <a
        href="/"
        class="inline-flex items-center gap-2 rounded-lg bg-brand-600 px-6 py-3 font-medium text-white shadow-sm shadow-brand-600/20 transition-all hover:-translate-y-0.5 hover:bg-brand-700 hover:shadow-lg hover:shadow-brand-600/30"
      >
        Scan your store →
      </a>
    </div>
  </section>

  <section class="max-w-3xl mx-auto px-6 py-12 prose prose-zephyr">
    <h2 class="text-2xl font-bold text-zephyr-900 mb-3">
      Why headless changes the answer
    </h2>
    <p class="text-zephyr-700">
      On a hosted Shopify theme, the platform emits a usable robots.txt, a
      sitemap, product JSON-LD, and (increasingly) agentic-commerce protocol
      surfaces for you. Go headless with Hydrogen and you own the request path:
      your Remix/React app decides what robots see, whether structured data is
      rendered on the server, and whether protocol endpoints exist at all. The
      most common failure isn't a misconfiguration — it's an absence. An agent
      that doesn't execute JavaScript sees an empty shell where your product data
      should be.
    </p>

    <h2 class="text-2xl font-bold text-zephyr-900 mt-10 mb-3">
      The Hydrogen agent-readiness checklist
    </h2>
    <p class="text-zephyr-700 mb-6">
      Fifteen checks across five categories. The ones most often missed on
      headless builds are called out below.
    </p>
  </section>

  <section class="max-w-3xl mx-auto px-6 pb-12 space-y-6">
    {
      checklist.map((group) => (
        <div class="group rounded-xl border border-zephyr-100 bg-white p-6 transition-all duration-200 hover:-translate-y-1 hover:border-brand-100 hover:shadow-lg hover:shadow-zephyr-900/5">
          <div class="flex items-center gap-3 mb-4">
            <span
              class={`inline-flex h-10 w-10 items-center justify-center rounded-lg ring-1 ring-inset transition-transform duration-200 group-hover:scale-110 ${group.accent}`}
              set:html={group.icon}
            />
            <h3 class="font-semibold text-zephyr-900">{group.cat}</h3>
          </div>
          <ul class="space-y-2.5 text-sm text-zephyr-700">
            {group.items.map((item) => (
              <li class="flex items-start gap-2.5">
                <svg viewBox="0 0 20 20" fill="currentColor" class="mt-0.5 h-4 w-4 shrink-0 text-brand-500">
                  <path fill-rule="evenodd" d="M16.7 5.3a1 1 0 0 1 0 1.4l-7.5 7.5a1 1 0 0 1-1.4 0L3.3 9.7a1 1 0 0 1 1.4-1.4l3.8 3.8 6.8-6.8a1 1 0 0 1 1.4 0Z" clip-rule="evenodd" />
                </svg>
                <span>{item}</span>
              </li>
            ))}
          </ul>
        </div>
      ))
    }
  </section>

  <section class="relative overflow-hidden bg-zephyr-900 text-white">
    <div class="hero-grid-dark pointer-events-none absolute inset-0" aria-hidden="true"></div>
    <div class="pointer-events-none absolute -left-24 -top-24 h-72 w-72 rounded-full bg-brand-500/20 blur-3xl" aria-hidden="true"></div>
    <div class="pointer-events-none absolute -right-24 bottom-0 h-72 w-72 rounded-full bg-sky-500/15 blur-3xl" aria-hidden="true"></div>
    <div class="relative max-w-3xl mx-auto px-6 py-16 text-center">
      <h2 class="text-2xl font-bold mb-3">
        Built on Hydrogen? Don't guess — measure.
      </h2>
      <p class="text-zephyr-100/80 mb-6">
        Agent Ready is open source and built by
        <a href="https://weaverse.io" class="underline hover:text-white">Weaverse</a>, the team
        behind Hydrogen theme tooling. Scan once, subscribe, and we'll re-check
        weekly and email you when a deploy changes your score.
      </p>
      <a
        href="/"
        class="inline-flex items-center gap-2 rounded-lg bg-white px-6 py-3 font-medium text-zephyr-900 shadow-sm transition-all hover:-translate-y-0.5 hover:shadow-lg"
      >
        Run a free scan →
      </a>
    </div>
  </section>
</Default>
