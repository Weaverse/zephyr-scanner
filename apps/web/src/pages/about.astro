---
import Default from "../layouts/Default.astro";
import Eyebrow from "../components/Eyebrow.astro";

const protocols = [
  {
    abbr: "UCP",
    name: "Universal Commerce Protocol",
    desc: "Storefront capability profile for agents",
  },
  {
    abbr: "MCP",
    name: "Model Context Protocol",
    desc: "Server card discovery (SEP-2127)",
  },
  {
    abbr: "ACP",
    name: "Agentic Commerce Protocol",
    desc: "Stripe + OpenAI checkout handoff",
  },
  {
    abbr: "x402",
    name: "HTTP 402 payments",
    desc: "Coinbase pay-per-request",
  },
  {
    abbr: "WebMCP",
    name: "Client-side tools for agents",
    desc: "W3C WebML CG",
  },
];
---

<Default title="Agent Ready — About">
  <section class="relative overflow-hidden border-b border-zephyr-100 bg-gradient-to-b from-brand-50/70 via-white to-white">
    <div class="hero-grid pointer-events-none absolute inset-0" aria-hidden="true"></div>
    <div class="pointer-events-none absolute -left-24 -top-24 h-72 w-72 rounded-full bg-brand-500/20 blur-3xl" aria-hidden="true"></div>
    <div class="pointer-events-none absolute -right-20 top-0 h-72 w-72 rounded-full bg-sky-400/20 blur-3xl" aria-hidden="true"></div>
    <div class="relative max-w-3xl mx-auto px-6 py-16 text-center">
      <Eyebrow label="About" />
      <h1 class="mt-6 text-4xl font-bold tracking-tight text-zephyr-900 mb-4">
        About
        <span class="bg-gradient-to-r from-brand-600 to-sky-500 bg-clip-text text-transparent">
          Agent Ready
        </span>
      </h1>
      <p class="text-lg text-zephyr-700">
        A free, public, commerce-focused agent-readiness scanner. Paste a store
        URL — get a 0–100 score across 5 categories plus a fix-it action list.
      </p>
    </div>
  </section>

  <section class="max-w-3xl mx-auto px-6 py-12 space-y-12">
    <div>
      <h2 class="text-xl font-semibold text-zephyr-900 mb-3">What we check</h2>
      <p class="text-zephyr-700">
        15 checks across discoverability, content, commerce protocols, product
        data, and checkout. The full matrix lives in
        <a
          class="font-medium text-brand-600 underline"
          href="https://github.com/Weaverse/zephyr-scanner/blob/main/docs/CHECKS.md"
        >
          docs/CHECKS.md
        </a>.
      </p>
    </div>

    <div>
      <h2 class="text-xl font-semibold text-zephyr-900 mb-4">
        Protocols covered
      </h2>
      <div class="grid gap-3 sm:grid-cols-2">
        {
          protocols.map((p) => (
            <div class="group flex items-start gap-3 rounded-xl border border-zephyr-100 bg-white p-4 transition-all duration-200 hover:-translate-y-0.5 hover:border-brand-100 hover:shadow-md hover:shadow-zephyr-900/5">
              <span class="inline-flex shrink-0 items-center justify-center rounded-lg bg-brand-50 px-2.5 py-1 font-mono text-xs font-bold text-brand-600 ring-1 ring-inset ring-brand-100">
                {p.abbr}
              </span>
              <div class="min-w-0">
                <p class="font-medium text-zephyr-900">{p.name}</p>
                <p class="text-sm text-zephyr-700">{p.desc}</p>
              </div>
            </div>
          ))
        }
      </div>
    </div>

    <div>
      <h2 class="text-xl font-semibold text-zephyr-900 mb-3">Who built this</h2>
      <p class="text-zephyr-700">
        Agent Ready is an open-source project from
        <a class="font-medium text-brand-600 underline" href="https://weaverse.io">Weaverse</a>.
        We build Hydrogen apps and tooling for AI-first commerce.
      </p>
    </div>

    <div class="rounded-xl border border-zephyr-100 bg-white p-6">
      <h2 class="text-xl font-semibold text-zephyr-900 mb-3">Scanner identity</h2>
      <p class="text-zephyr-700">
        Outbound requests carry
        <code class="rounded bg-zephyr-50 px-1.5 py-0.5 font-mono text-sm text-zephyr-900">
          User-Agent: AgentReadyBot/0.1 (+https://isyourstoreagentready.com)
        </code>. Disallow this UA in your
        <code class="rounded bg-zephyr-50 px-1.5 py-0.5 font-mono text-sm text-zephyr-900">robots.txt</code>
        to block scans.
      </p>
    </div>

    <div>
      <h2 class="text-xl font-semibold text-zephyr-900 mb-3">Contributing</h2>
      <p class="text-zephyr-700">
        MIT licensed. Contributions welcome — see
        <a
          class="font-medium text-brand-600 underline"
          href="https://github.com/Weaverse/zephyr-scanner/blob/main/CONTRIBUTING.md"
        >
          CONTRIBUTING.md
        </a>.
      </p>
    </div>
  </section>
</Default>
