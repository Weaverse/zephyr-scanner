---
import Default from "../../layouts/Default.astro";
import Eyebrow from "../../components/Eyebrow.astro";

const checkSvg = `<svg viewBox="0 0 20 20" fill="currentColor" class="h-5 w-5"><path fill-rule="evenodd" d="M10 18a8 8 0 1 0 0-16 8 8 0 0 0 0 16Zm3.7-9.3a1 1 0 0 0-1.4-1.4L9 10.6 7.7 9.3a1 1 0 0 0-1.4 1.4l2 2a1 1 0 0 0 1.4 0l4-4Z" clip-rule="evenodd"/></svg>`;
const dashSvg = `<svg viewBox="0 0 20 20" fill="currentColor" class="h-5 w-5"><path fill-rule="evenodd" d="M4 10a1 1 0 0 1 1-1h10a1 1 0 1 1 0 2H5a1 1 0 0 1-1-1Z" clip-rule="evenodd"/></svg>`;

const title = "Agent Ready vs Shopify Commerce Readiness — Compare";
const description =
  "Shopify's Commerce Readiness tool scores Liquid storefronts in one shot. Agent Ready adds headless/Hydrogen depth, scores agentic-commerce protocols, and re-checks over time. An honest comparison.";
const canonical = "https://isyourstoreagentready.com/compare/shopify-commerce-readiness";

const rows = [
  { feature: "Free, no signup", zephyr: true, them: true },
  { feature: "Works on classic Liquid storefronts", zephyr: true, them: true },
  {
    feature: "Headless / Hydrogen-aware checks",
    zephyr: "Built for it",
    them: "Assumes hosted theme",
  },
  {
    feature: "Scores agentic-commerce protocols (UCP, MCP, ACP, x402, WebMCP)",
    zephyr: "Scored, with verified-live spec briefs",
    them: "Partial",
  },
  {
    feature: "Per-check remediation hints",
    zephyr: "Every failing check",
    them: "Ranks gaps, doesn't fix",
  },
  {
    feature: "Re-scan over time + email on score change",
    zephyr: "Weekly change-detection",
    them: false,
  },
  { feature: "Embeddable badge", zephyr: true, them: false },
  { feature: "Open source", zephyr: true, them: false },
];
---

<Default
  title={title}
  description={description}
  ogUrl={canonical}
  canonical={canonical}
>
  <section class="relative overflow-hidden border-b border-zephyr-100 bg-gradient-to-b from-brand-50/60 via-white to-white">
    <div class="hero-grid pointer-events-none absolute inset-0" aria-hidden="true"></div>
    <div class="pointer-events-none absolute -left-24 -top-24 h-72 w-72 rounded-full bg-brand-500/20 blur-3xl" aria-hidden="true"></div>
    <div class="relative max-w-3xl mx-auto px-6 py-16">
      <a
        href="/compare"
        class="group mb-5 flex w-fit items-center gap-1.5 text-sm font-medium text-zephyr-700 transition-colors hover:text-brand-600"
      >
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-4 w-4 transition-transform group-hover:-translate-x-0.5"><path d="M19 12H5m0 0 7 7m-7-7 7-7" /></svg>
        Back to Compare
      </a>
      <Eyebrow label="Comparison" />
      <h1 class="mt-5 text-3xl sm:text-4xl font-bold tracking-tight text-zephyr-900 mb-4">
        Agent Ready vs Shopify Commerce Readiness
      </h1>
      <p class="text-lg text-zephyr-700">
        Shopify quietly shipped its own scanner at
        <code class="font-mono text-sm">commerce-readiness.shopify.io</code> — 31
        checks across five categories, free, no login. It's a solid diagnostic.
        But it's built for the classic hosted-theme world and stops at the
        snapshot. Here's where Agent Ready goes further.
        <span class="text-zephyr-500">(Public information as of May 2026.)</span>
      </p>
    </div>
  </section>

  <section class="max-w-3xl mx-auto px-6 py-12">
    <div class="overflow-hidden rounded-xl border border-zephyr-100 bg-white shadow-sm">
      <table class="w-full text-sm">
        <thead>
          <tr class="border-b border-zephyr-100 text-left">
            <th class="px-4 py-3.5 font-semibold text-zephyr-500">Capability</th>
            <th class="px-4 py-3.5 bg-brand-50 font-semibold text-brand-700">
              <span class="inline-flex items-center gap-1.5">
                <span class="h-2 w-2 rounded-full bg-brand-500" />
                Agent Ready
              </span>
            </th>
            <th class="px-4 py-3.5 font-semibold text-zephyr-600">
              Shopify Commerce Readiness
            </th>
          </tr>
        </thead>
        <tbody class="divide-y divide-zephyr-100">
          {
            rows.map((r) => (
              <tr class="align-top transition-colors hover:bg-zephyr-50/70">
                <td class="px-4 py-3 font-medium text-zephyr-900">{r.feature}</td>
                <td class="bg-brand-50/40 px-4 py-3 text-zephyr-900">
                  {r.zephyr === true ? (
                    <span class="text-grade-a" set:html={checkSvg} />
                  ) : r.zephyr === false ? (
                    <span class="text-zephyr-300" set:html={dashSvg} />
                  ) : (
                    r.zephyr
                  )}
                </td>
                <td class="px-4 py-3 text-zephyr-700">
                  {r.them === true ? (
                    <span class="text-grade-a" set:html={checkSvg} />
                  ) : r.them === false ? (
                    <span class="text-zephyr-300" set:html={dashSvg} />
                  ) : (
                    r.them
                  )}
                </td>
              </tr>
            ))
          }
        </tbody>
      </table>
    </div>

    <div class="prose prose-zephyr mt-10">
      <h2 class="text-2xl font-bold text-zephyr-900 mb-3">
        Where Shopify's tool is great
      </h2>
      <p class="text-zephyr-700">
        If you run a standard Shopify theme, Shopify's scanner is the most native
        read you can get — it knows the platform's own structured-data output and
        flags the universal misses (absent llms.txt, incomplete product JSON-LD,
        thin policy pages) that fail on nearly every store. Start there if that's
        you.
      </p>

      <h2 class="text-2xl font-bold text-zephyr-900 mt-8 mb-3">
        Where Agent Ready is the better fit
      </h2>
      <ul class="text-zephyr-700 list-disc pl-6 space-y-2">
        <li>
          <strong>You're headless / Hydrogen.</strong> Once you decouple the
          storefront, robots, sitemaps, JSON-LD, and protocol endpoints become
          your app's responsibility. Agent Ready checks that headless reality instead
          of assuming the platform serves it.
        </li>
        <li>
          <strong>You care about agent commerce protocols.</strong> Agent Ready scores
          UCP, MCP server cards, ACP, x402, and WebMCP against spec briefs
          verified against live implementations.
        </li>
        <li>
          <strong>You want to track drift.</strong> A score is a moment in time;
          a deploy can break it. Subscribe and Agent Ready re-scans weekly and emails
          you when your grade moves.
        </li>
      </ul>
    </div>

    <div class="relative mt-10 overflow-hidden rounded-xl bg-zephyr-900 p-8 text-center text-white">
      <div class="hero-grid-dark pointer-events-none absolute inset-0" aria-hidden="true"></div>
      <div class="pointer-events-none absolute -right-16 -top-16 h-56 w-56 rounded-full bg-brand-500/20 blur-3xl" aria-hidden="true"></div>
      <div class="relative">
        <p class="text-lg font-semibold mb-4">
          Scan your store and see your commerce-readiness score.
        </p>
        <a
          href="/"
          class="inline-flex items-center gap-2 rounded-lg bg-white px-6 py-3 font-medium text-zephyr-900 shadow-sm transition-all hover:-translate-y-0.5 hover:shadow-lg"
        >
          Run a free scan →
        </a>
      </div>
    </div>
  </section>
</Default>
